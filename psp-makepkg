#!/bin/bash

## Make sure PSPDEV is set
if [ -z "${PSPDEV}" ]; then
    echo "The PSPDEV environment variable has not been set"
    exit 1
fi

if [ ! -d "${PSPDEV}" ]; then
    echo "${PSPDEV} does not exist"
    exit 2
fi

## Export makepkg variables
export PACMAN=psp-pacman
export MAKEPKG_CONF="${PSPDEV}/etc/makepkg.conf"
export CARCH="$(${PSPDEV}/share/pacman/bin/get-arch)"

## Add the directory with pacman's binaries to the start of the PATH
export PATH="${PSPDEV}/share/pacman/bin:${PATH}"

## Configure host pkg-config for PSP cross compilation.
## Target .pc files describe the PSP filesystem rooted at /psp; pkg-config
## maps those target paths into the installed PSPDEV sysroot for the build.
if ! command -v pkg-config >/dev/null 2>&1; then
    echo "pkg-config is required to build PSP packages"
    exit 3
fi
export PKG_CONFIG="$(command -v pkg-config)"
export PKG_CONFIG_DIR=
export PKG_CONFIG_PATH=
export PKG_CONFIG_LIBDIR="${PSPDEV}/psp/lib/pkgconfig:${PSPDEV}/psp/share/pkgconfig"
export PKG_CONFIG_SYSROOT_DIR="${PSPDEV}"

## Avoid embedding local package build paths in debug info, diagnostics, and
## __FILE__-style strings. Prefer the explicit BUILDDIR passed by psp-packages;
## otherwise fall back to the current working directory.
build_root=""
for arg in "$@"; do
    case "$arg" in
        BUILDDIR=*) build_root="${arg#BUILDDIR=}" ;;
    esac
done
if [ -z "${build_root}" ]; then
    build_root="$PWD"
fi
build_root="$(realpath -m "${build_root}")"
pathmap_flags="-ffile-prefix-map=${build_root}=. -fdebug-prefix-map=${build_root}=. -fmacro-prefix-map=${build_root}=."
export CPPFLAGS="${CPPFLAGS:+${CPPFLAGS} }${pathmap_flags}"
export CFLAGS="${CFLAGS:+${CFLAGS} }${pathmap_flags}"
export CXXFLAGS="${CXXFLAGS:+${CXXFLAGS} }${pathmap_flags}"

## Run makepkg
makepkg "$@"
