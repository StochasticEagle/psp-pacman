diff --git a/test/pacman/tests/query008.py b/test/pacman/tests/query008.py
new file mode 100644
--- /dev/null
+++ b/test/pacman/tests/query008.py
@@ -0,0 +1,21 @@
+self.description = "Query installed sizes using 1024-based byte units"
+
+sizes = [
+    ("units-bytes", 1023),
+    ("units-kb", 1024),
+    ("units-mb", 1024 * 1024),
+    ("units-gb", 1024 * 1024 * 1024),
+]
+
+for name, size in sizes:
+    p = pmpkg(name)
+    p.size = str(size)
+    self.addpkg2db("local", p)
+
+self.args = "-Qi " + " ".join(name for name, _ in sizes)
+
+self.addrule("PACMAN_RETCODE=0")
+self.addrule("PACMAN_OUTPUT=^Installed Size.*1023.00 B")
+self.addrule("PACMAN_OUTPUT=^Installed Size.*1.00 KB")
+self.addrule("PACMAN_OUTPUT=^Installed Size.*1.00 MB")
+self.addrule("PACMAN_OUTPUT=^Installed Size.*1.00 GB")
