diff --git a/lib/libalpm/be_sync.c b/lib/libalpm/be_sync.c
--- a/lib/libalpm/be_sync.c
+++ b/lib/libalpm/be_sync.c
@@ -209,7 +209,7 @@
 		payload->unlink_on_fail = 1;
 		payload->download_signature = (siglevel & ALPM_SIG_DATABASE);
