pkgname=psp-pacman
pkgver=7.1.0
pkgrel=6
pkgdesc="The package manager for the PSPDEV SDK."
_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
_PACMAN_SOURCE="${_REPO_ROOT}/components/pacman"
_PACMAN_SOURCE_SHA="$(git -C "${_PACMAN_SOURCE}" rev-parse HEAD 2>/dev/null || true)"
arch=(
  "alpine_x86_64"
  "ubuntu_x86_64"
  "ubuntu_aarch64"
  "debian_x86_64"
  "fedora_x86_64"
  "linux_x86_64"
  "linux_aarch64"
  "macos_x86_64"
  "macos_arm64"
)
url="https://github.com/StochasticEagle/psp-pacman"
license=('GPL-2.0-only')
groups=()
depends=()
makedepends=()
optdepends=()
provides=()
source=(
  "makepkg.conf"
  "pacman.conf"
  "pacman-${pkgver}-psp-strip.patch"
  "pacman-${pkgver}-rootless.patch"
  "pacman-${pkgver}-add-asroot-option.patch"
  "pacman-${pkgver}-binary-units.patch"
  "pacman-${pkgver}-unit-terminology.patch"
  "get-arch"
  "install-permissions.sh"
  "psp-makepkg"
  "psp-pacman"
)
sha256sums=(
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
)


pspdev_pacman_source_state() {
  printf '%s\n' \
    "schema=1" \
    "repo=${_REPO_ROOT}" \
    "source=${_PACMAN_SOURCE}" \
    "source-sha=${_PACMAN_SOURCE_SHA}" \
    "pkgver=${pkgver}" \
    "pkgrel=${pkgrel}"
}

pspdev_pacman_source_state_matches() {
  local source_tree="$1"
  local marker="${source_tree}/.pspdev-source-state"

  [[ -f "${marker}" ]] || return 1
  [[ "$(cat "${marker}")" == "$(pspdev_pacman_source_state)" ]]
}

pspdev_pacman_meson_state() {
  local source_dir="$1"
  local build_dir="$2"

  printf '%s\n' \
    "schema=1" \
    "source=${source_dir}" \
    "build=${build_dir}" \
    "prefix=${pkgdir}" \
    "buildtype=release" \
    "default-library=static" \
    "buildscript=PSPBUILD" \
    "root-dir=${pkgdir}" \
    "sysconfdir=etc" \
    "makepkg-template-dir=share/makepkg-template" \
    "bindir=share/pacman/bin" \
    "localstatedir=var" \
    "doc=disabled" \
    "i18n=false" \
    "bash-completions-dir=share/bash-completion/completions"
}

prepare() {
  if [ ! -f "${_PACMAN_SOURCE}/meson.build" ]; then
    echo "ERROR: Pacman source submodule is not initialized."
    return 1
  fi

  rm -rf "pacman-v${pkgver}"
  mkdir -p "pacman-v${pkgver}"

  cp -a "${_PACMAN_SOURCE}/." "pacman-v${pkgver}/"

  # Never modify submodule metadata in the build copy.
  rm -rf "pacman-v${pkgver}/.git"

  cd "pacman-v${pkgver}"

  apply_patch() {
    local patch_file="$1"
    local output

    if ! output="$(patch --dry-run --batch --forward --fuzz=0 -p1 < "$patch_file" 2>&1)"; then
      printf '%s\n' "$output" >&2
      echo "ERROR: patch failed to apply: $patch_file" >&2
      return 1
    fi

    printf '%s\n' "$output"
    if grep -Eq 'with fuzz|offset [0-9]+ lines?' <<< "$output"; then
      echo "WARNING: patch drift detected: $patch_file" >&2
      if [[ -n ${GITHUB_ACTIONS:-} ]]; then
        printf '::warning::Patch drift detected in %s; refresh the patch against the current source.\n' "$patch_file"
      fi
    fi

    patch --batch --forward --fuzz=0 -p1 < "$patch_file"
  }

  apply_patch "../pacman-${pkgver}-psp-strip.patch"
  apply_patch "../pacman-${pkgver}-rootless.patch"
  apply_patch "../pacman-${pkgver}-add-asroot-option.patch"
  apply_patch "../pacman-${pkgver}-binary-units.patch"
  apply_patch "../pacman-${pkgver}-unit-terminology.patch"

  find ./ -type f -name "*.in" -exec sed -i -e \
    "s#LIBRARY=\${LIBRARY:-'@libmakepkgdir@'}#LIBRARY=\${LIBRARY:-\"\${PSPDEV}/share/makepkg\"}#g" {} \;

  find ./ -type f -name "*.in" -exec sed -i -e \
    "s#declare -r confdir='@sysconfdir@'#declare -r confdir=\"\${PSPDEV}/etc\"#g" {} \;

  find ./ -type f -name "*.in" -exec sed -i -e \
    "s#export TEXTDOMAINDIR='@localedir@'#export TEXTDOMAINDIR=\"\${PSPDEV}/share/locale\"#g" {} \;

  find ./ -type f -name "*.in" -exec sed -i -e \
    "s#'@libmakepkgdir@'#\${PSPDEV}/share/makepkg#g" {} \;

  find ./ -type f -name "*.in" -exec sed -i -e \
    "s#@libmakepkgdir@#\${PSPDEV}/share/makepkg#g" {} \;

  pspdev_pacman_source_state > .pspdev-source-state
}

build() {
  cd "pacman-v${pkgver}"

  source_dir="$(pwd -P)"
  build_dir="${source_dir}/build"
  state_file="${build_dir}/.pspdev-meson-state"
  expected_state="$(pspdev_pacman_meson_state "${source_dir}" "${build_dir}")"

  if [[ -d "${build_dir}" ]]; then
    if [[ ! -f "${state_file}" || "$(cat "${state_file}")" != "${expected_state}" ]]; then
      echo "Refreshing psp-pacman Meson build tree: configuration or path changed."
      rm -rf "${build_dir}"
    fi
  fi

  meson_args=(
    -Dprefix="${pkgdir}"
    --buildtype=release
    -Ddefault_library=static
    -Dbuildscript=PSPBUILD
    -Droot-dir="${pkgdir}"
    -Dsysconfdir="etc"
    -Dmakepkg-template-dir="share/makepkg-template"
    -Dbindir="share/pacman/bin"
    -Dlocalstatedir="var"
    -Ddoc=disabled
    -Di18n=false
    -Dbash-completions-dir="share/bash-completion/completions"
  )

  if [[ -f "${build_dir}/build.ninja" ]]; then
    meson setup "${build_dir}" --reconfigure "${meson_args[@]}"
  else
    meson setup "${build_dir}" "${meson_args[@]}"
  fi

  printf '%s\n' "${expected_state}" > "${state_file}"
  ninja -C "${build_dir}"
}

package() {
  cd "pacman-v${pkgver}/build"
  ninja install

  cd ..

  mkdir  -m 755 -p "${pkgdir}/etc/"
  install -m 644 "${_REPO_ROOT}/pacman.conf" "${pkgdir}/etc/pacman.conf"
  install -m 644 "${_REPO_ROOT}/makepkg.conf" "${pkgdir}/etc/makepkg.conf"

  mkdir  -m 755 -p "${pkgdir}/bin/"
  install -m 755 "${_REPO_ROOT}/psp-pacman" "${pkgdir}/bin/psp-pacman"
  install -m 755 "${_REPO_ROOT}/psp-makepkg" "${pkgdir}/bin/psp-makepkg"
  install -m 755 "${_REPO_ROOT}/get-arch" "${pkgdir}/share/pacman/bin/get-arch"

  mkdir -m 755 -p "${pkgdir}/share/psp-pacman"
  install -m 644 "${_REPO_ROOT}/install-permissions.sh" "${pkgdir}/share/psp-pacman/install-permissions.sh"

  mkdir -m 755 -p "$pkgdir/share/licenses/$pkgname"
  install -m 644 COPYING "$pkgdir/share/licenses/$pkgname"

  # Add empty directories which psp-pacman will use
  mkdir -m 755 -p "${pkgdir}/etc/pacman.d/gnupg/"
  mkdir -m 755 -p "${pkgdir}/var/log/"
  mkdir -m 755 -p "${pkgdir}/etc/pacman.d/hooks"
  mkdir -m 755 -p "${pkgdir}/var/lib/pacman"
}
